# Copy to .env. Everything works offline with the defaults; keys switch on LLM generation.

# offline (extractive, no key) | anthropic | openai
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# offline (LSA fitted on the corpus) | openai (text-embedding-3-small at the same dimension)
EMBEDDING_PROVIDER=offline
EMBEDDING_DIM=768

# Model used to project cost per query when LLM_PROVIDER=offline
COST_REFERENCE_MODEL=claude-sonnet-5-5

# Optional: require X-API-Key on /v1/ask and /v1/metrics
ASSISTANT_API_KEY=
